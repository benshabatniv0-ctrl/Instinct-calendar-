{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "instinct-calendar",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // Israel time, including its daylight-saving rules. All local times sent to /api are read in this zone
    // unless the target calendar publishes its own zone or the request names one.
    "CALENDAR_TIME_ZONE": "Asia/Jerusalem"
  },
  // Secrets (ICLOUD_USERNAME, ICLOUD_APP_PASSWORD, APPROVAL_PASSWORD, API_KEYS) are added in the dashboard
  // after the first deploy. They are not declared as required so that first deploy can succeed; until they
  // exist the Worker fails closed (no approvals, API disabled, no iCloud access).
  // No KV namespaces: OAuth and Reminders state live in the Guard Durable Object (src/guard.ts),
  // because Workers Builds' automatic KV provisioning fails on retried builds.
  // Rate limits, single-use confirmation tokens, idempotency records and the audit log.
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "GUARD", "class_name": "Guard" }]
  },
  "migrations": [{ "tag": "v1-guard", "new_sqlite_classes": ["Guard"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
